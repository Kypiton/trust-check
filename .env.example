# TrustCheck environment template
# Copy to .env.local for local development. Never commit real production secrets.

# PostgreSQL. Local Docker Compose example:
DATABASE_URL="postgresql://trustcheck:trustcheck_dev@localhost:5433/trustcheck"

# Canonical application origin used for metadata, robots and sitemap.
# Development may use HTTP localhost; production MUST use the real public HTTPS origin.
APP_URL="http://localhost:3000"

# Better Auth must use the same public origin as APP_URL in production.
BETTER_AUTH_URL="http://localhost:3000"
# Replace with a cryptographically random, stable secret of at least 32 bytes.
BETTER_AUTH_SECRET="replace-with-random-secret-at-least-32-bytes"

# Separate stable secret used to HMAC anonymous rate-limit identities.
# Do not reuse BETTER_AUTH_SECRET.
RATE_LIMIT_SECRET="replace-with-independent-random-secret-at-least-32-bytes"

# Optional. If omitted, Google Web Risk coverage is reported as skipped/unavailable.
GOOGLE_WEB_RISK_API_KEY=""

# Local development: keep proxy trust disabled.
# Production: set TRUST_PROXY_IP_HEADERS=true only when the deployment proxy overwrites
# TRUSTED_CLIENT_IP_HEADER with exactly one verified client IP and direct origin access is blocked.
TRUST_PROXY_IP_HEADERS="false"
TRUSTED_CLIENT_IP_HEADER=""
